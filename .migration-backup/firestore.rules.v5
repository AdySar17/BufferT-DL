rules_version = '2';

/* ============================================================================
 *  BFT Demon List — Reglas de Firestore  (archivo V5)
 *
 *  CÓMO PUBLICAR:
 *    1. Firebase Console → proyecto bufferteam-a95b3
 *    2. Firestore Database → pestaña "Rules"
 *    3. Borra TODO lo que haya y pega este archivo entero
 *    4. Pulsa "Publish"
 *
 *  Cambios respecto a V4:
 *    - Soporta el nuevo rol "Booster" (sin privilegios extra a nivel reglas;
 *      sólo se usa para PRIORIDAD en el panel del staff y badge en el perfil).
 *    - Los Admin NO pueden tocar al Owner ni cambiarse a sí mismos.
 *    - Los Admin NO pueden ascender a nadie a Admin u Owner.
 *    - El Owner puede cambiar cualquier rol, incluido el suyo.
 *    - Validación explícita de los campos de moderación que escribe el staff
 *      en /records: staffnotes, moderatedAt, moderatedBy, acceptedAt.
 *
 *  Roles soportados:
 *    Owner   — control total de la lista, puede cambiar cualquier rol.
 *    Admin   — modera records, edita niveles, gestiona roles de no-staff.
 *    Mod     — modera records, edita niveles.
 *    Booster — sin permisos extra; solo prioridad en el panel + badge.
 *    Default — usuario normal.
 *
 *  Lectura PÚBLICA (sin login):  levels, profiles, records, positionHistory
 *  Escritura segura:
 *    - profiles/{uid} : sólo el dueño (o staff)
 *    - records        : el dueño crea/edita/elimina los suyos; staff modera
 *    - levels         : sólo staff (Mod/Admin/Owner) — incluye minPercent
 *    - users/{uid}    : reglas finas de cambio de rol (ver más abajo)
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helpers ───────────────────────────────────────────────── */
    function isSignedIn() { return request.auth != null; }
    function isOwnerOf(uid) { return isSignedIn() && request.auth.uid == uid; }

    function myDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return myDoc().data.role; }

    function isStaff()   { return isSignedIn() && myRole() in ['Mod','Admin','Owner']; }
    function isAdminish(){ return isSignedIn() && myRole() in ['Admin','Owner']; }
    function isOwnerRole(){ return isSignedIn() && myRole() == 'Owner'; }

    function isValidRole(r) {
      return r in ['Default','Mod','Admin','Owner','Booster'];
    }

    /* ─── Perfiles públicos ─────────────────────────────────────── */
    match /profiles/{uid} {
      allow read:   if true;
      allow create: if isOwnerOf(uid);
      allow update: if isOwnerOf(uid) || isStaff();
      allow delete: if isAdminish();
    }

    /* ─── Niveles públicos ──────────────────────────────────────── *
     *  Campos soportados (todos opcionales salvo name/position):
     *    name, author, creators, thumbnail, background, video,
     *    glow (bool), is2P (bool), description, difficulty,
     *    minPercent (1-100, default 100), tags, position, value.       */
    match /levels/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    /* ─── Historial de posiciones (público, escribe staff) ─────── */
    match /positionHistory/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    /* ─── Records públicos ──────────────────────────────────────── *
     *  Campos: userId, player2Id?, levelId, percent (1-100),
     *  video, video2?, mobile, mobile2P, mode2P, rawFootage, extraNotes,
     *  status ("Pending"|"Accepted"|"Rejected"),
     *  createdAt, updatedAt, acceptedAt,
     *  staffnotes (string opcional, hasta 500 chars),
     *  moderatedAt (serverTimestamp), moderatedBy (uid del staff).       */
    match /records/{id} {
      allow read: if true;

      /* Crear: solo el propio usuario, en estado Pending */
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status   == "Pending";

      /* Update:
       *   - Staff: puede moderar libremente (incluye fijar acceptedAt,
       *            staffnotes, moderatedAt y moderatedBy).
       *   - Dueño: puede editar SUS records sin cambiar userId, y
       *            volviendo el status a Pending. */
      allow update: if isStaff()
                    || (isOwnerOf(resource.data.userId)
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.status == "Pending");

      /* Delete:
       *   - Staff: siempre puede.
       *   - Dueño: solo si el record NO está Accepted. */
      allow delete: if isStaff()
                    || (isOwnerOf(resource.data.userId)
                        && resource.data.status != "Accepted");
    }

    /* ─── /users : datos de cuenta + ROL ─────────────────────────── *
     *  Permisos de UPDATE — combinaciones permitidas:
     *
     *  (A) El propio usuario actualiza su doc, pero NO toca role/banned.
     *  (B) El Owner (rol "Owner") puede cambiar CUALQUIER doc, incluido
     *      su propio rol y el de otros (incluso a/desde "Owner").
     *  (C) Un Admin puede cambiar el role de OTROS usuarios SOLO si:
     *        · el target NO tiene rol "Owner" actualmente,
     *        · el target NO es él mismo,
     *        · el nuevo rol NO es "Admin" ni "Owner",
     *      y NO puede cambiar el flag "banned" salvo si es Owner.
     *  Cualquier otro intento es denegado.                              */
    match /users/{uid} {
      allow read:   if isOwnerOf(uid) || isStaff();
      allow create: if isOwnerOf(uid);

      allow update: if
        /* (A) self-update sin tocar role ni banned */
        ( isOwnerOf(uid)
          && !( "role"   in request.resource.data.diff(resource.data).affectedKeys() )
          && !( "banned" in request.resource.data.diff(resource.data).affectedKeys() )
        )
        ||
        /* (B) Owner: control total */
        ( isOwnerRole()
          && ( !( "role" in request.resource.data.diff(resource.data).affectedKeys() )
               || isValidRole(request.resource.data.role) )
        )
        ||
        /* (C) Admin: cambia roles de no-staff a no-staff, y no a sí mismo */
        ( myRole() == 'Admin'
          && uid != request.auth.uid
          && resource.data.role != 'Owner'
          && !( "banned" in request.resource.data.diff(resource.data).affectedKeys() )
          && (
               !( "role" in request.resource.data.diff(resource.data).affectedKeys() )
               || (
                    isValidRole(request.resource.data.role)
                    && !(request.resource.data.role in ['Admin','Owner'])
                  )
             )
        );

      allow delete: if isOwnerRole();
    }
  }
}
