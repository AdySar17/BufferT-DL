rules_version = '2';

/* ============================================================================
 *  BFT Demon List — Reglas de Firestore  (archivo V15)
 *
 *  CÓMO PUBLICAR:
 *    1. Firebase Console → proyecto bufferteam-a95b3
 *    2. Firestore Database → pestaña "Rules"
 *    3. Borra TODO lo que haya y pega este archivo entero
 *    4. Pulsa "Publish"
 *
 *  Cambios respecto a V14:
 *    - Los Mods AHORA pueden moderar (aceptar / rechazar) los reclamos
 *      de "Añadir nivel + añadir record"  (records con
 *      isNewLevelClaim == true).  Antes esto era exclusivo de Admin/Owner.
 *
 *    - Los Mods siguen pudiendo CREAR niveles (necesario para que el
 *      flujo de "aceptar reclamo" funcione: añadir el nivel nuevo a la
 *      lista) pero ya NO pueden EDITAR libremente los datos de un nivel
 *      una vez creado.
 *      La única edición que se les permite sobre /levels es el reajuste
 *      automático de `position` y `value` que ocurre al insertar un
 *      nivel nuevo (re-shift en cascada de los demás niveles).
 *
 *      Esto se implementa exigiendo que, cuando el rol es Mod, los
 *      campos modificados en el documento sean exclusivamente
 *      ['position'] o ['position','value'].  Cualquier otra edición
 *      (nombre, autor, video, dificultad, gdLevelId, etc.) requiere
 *      Admin u Owner.
 *
 *  Cambios respecto a V12 (heredados de V14):
 *    - SEGURIDAD: los Admin no pueden BORRAR niveles.
 *      Solo el Owner puede eliminar documentos en /levels.
 *
 *  Cambios respecto a V11:
 *    - El rol Owner puede CREAR records con cualquier `userId`
 *      (no sólo el suyo).
 *
 *  Cambios respecto a V10:
 *    - El rol Owner puede ACTUALIZAR cualquier record de cualquier
 *      usuario, sin restricción de status ni de campos (excepto userId).
 *
 *  Cambios respecto a V9 (heredados):
 *    - /profiles/{uid} admite el campo opcional `youtube`.
 *    - Stat "Hardest" se calcula en cliente.
 *
 *  Cambios respecto a V8 (heredados):
 *    - Reclamo de NUEVO NIVEL identificado por ID de Geometry Dash.
 *    - /levels admite gdLevelId opcional.
 *
 *  Roles soportados:
 *    Owner   — control total. Puede aceptar reclamos, editar todo.
 *    Admin   — modera records, acepta reclamos, edita niveles libremente.
 *    Mod     — modera records (incluyendo reclamos de Nuevo nivel)
 *              y crea niveles al aceptar reclamos, pero NO puede
 *              editar datos de niveles ya existentes (solo el
 *              reajuste automático de position/value que dispara
 *              la inserción).
 *    Booster — sin permisos extra; solo prioridad en el panel + badge.
 *    Default — usuario normal.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helpers ───────────────────────────────────────────────── */
    function isSignedIn() { return request.auth != null; }
    function isOwnerOf(uid) { return isSignedIn() && request.auth.uid == uid; }

    function myDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return myDoc().data.role; }

    function isStaff()    { return isSignedIn() && myRole() in ['Mod','Admin','Owner']; }
    function isAdminish() { return isSignedIn() && myRole() in ['Admin','Owner']; }
    function isOwnerRole(){ return isSignedIn() && myRole() == 'Owner'; }

    function isValidRole(r) {
      return r in ['Default','Mod','Admin','Owner','Booster'];
    }

    /* Valida que la cadena sea solo dígitos 0-9, longitud 1..20.       *
     * Sirve para el ID de un nivel de Geometry Dash.                   */
    function isGdId(s) {
      return s is string
             && s.size() > 0
             && s.size() <= 20
             && s.matches('^[0-9]+$');
    }

    /* ─── Perfiles públicos ─────────────────────────────────────── */
    function isValidYoutube(v) {
      return !('youtube' in request.resource.data)
          || v == null
          || (v is string && v.size() == 0)
          || (v is string && v.size() <= 200 && v.matches('^https?://.*'));
    }
    match /profiles/{uid} {
      allow read:   if true;
      allow create: if isOwnerOf(uid)
                    && isValidYoutube(request.resource.data.youtube);
      allow update: if (isOwnerOf(uid) || isStaff())
                    && isValidYoutube(request.resource.data.youtube);
      allow delete: if isAdminish();
    }

    /* ─── Niveles públicos ──────────────────────────────────────── *
     *  Campos: name, author, creators[], position, value, thumbnail,
     *  background, video, glow, is2P, description, difficulty,
     *  minPercent, tags[], y opcionalmente gdLevelId.
     *
     *  CREATE  → cualquier staff (Mod/Admin/Owner). El Mod necesita
     *            poder crear niveles para completar el flujo de
     *            "aceptar reclamo de Nuevo nivel".
     *
     *  UPDATE  → Admin/Owner pueden editar cualquier campo libremente.
     *            Mod sólo puede tocar el reajuste automático de
     *            position (y opcionalmente value, que se recalcula a
     *            partir de la posición). Cualquier otra edición está
     *            prohibida para los Mods.
     *
     *  DELETE  → SOLO Owner.                                            */
    match /levels/{id} {
      allow read:   if true;
      allow create: if isStaff();
      allow update: if
        /* Admin/Owner: edición libre */
        isAdminish()
        ||
        /* Mod: SOLO reajuste de posición (y opcionalmente value) */
        ( isStaff()
          && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['position','value'])
        );
      allow delete: if isOwnerRole();
    }

    /* ─── Historial de posiciones (público, escribe staff) ─────── */
    match /positionHistory/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    /* ─── Records públicos ──────────────────────────────────────── *
     *  Campos básicos: userId, player2Id?, levelId, percent (1-100),
     *  video, video2?, mobile, mobile2P, mode2P, rawFootage, extraNotes,
     *  status ("Pending"|"Accepted"|"Rejected"),
     *  createdAt, updatedAt, acceptedAt,
     *  staffnotes (string opcional, hasta 500 chars),
     *  moderatedAt (serverTimestamp), moderatedBy (uid del staff).
     *
     *  Campos para reclamo de "Nuevo nivel":
     *    isNewLevelClaim  : bool   (opcional, default false)
     *    claimedLevelName : string (≤ 100 chars)
     *    claimedLevelId   : string numérico (ID de Geometry Dash, 1..20)
     *  Cuando isNewLevelClaim == true, levelId puede ser null mientras
     *  el record esté en Pending.                                       */
    match /records/{id} {
      allow read: if true;

      /* Crear: el propio usuario en estado Pending.
       * El rol Owner puede crear con cualquier userId (registrar records
       * en nombre de otros jugadores).
       * Si es reclamo de Nuevo nivel se exige nombre + ID de GD. */
      allow create: if isSignedIn()
                    && ( request.resource.data.userId == request.auth.uid
                         || isOwnerRole() )
                    && request.resource.data.status == "Pending"
                    && (
                      /* Caso normal */
                      ( !("isNewLevelClaim" in request.resource.data)
                        || request.resource.data.isNewLevelClaim == false )
                      ||
                      /* Caso reclamo de Nuevo nivel */
                      ( request.resource.data.isNewLevelClaim == true
                        && request.resource.data.claimedLevelName is string
                        && request.resource.data.claimedLevelName.size() > 0
                        && request.resource.data.claimedLevelName.size() <= 100
                        && isGdId(request.resource.data.claimedLevelId)
                      )
                    );

      /* Update:
       *   - Owner: control total (sin tocar userId).
       *   - Cualquier staff (Mod/Admin/Owner) puede aceptar/rechazar
       *     records normales Y reclamos de Nuevo nivel.
       *     (Antes los reclamos eran exclusivos de Admin/Owner; en V15
       *      los Mods también pueden moderarlos.)
       *   - El dueño puede editar SUS records (sin cambiar userId) y
       *     el record vuelve a Pending. */
      allow update: if
        /* Owner: control total sobre records ajenos o propios */
        ( isOwnerRole()
          && request.resource.data.userId == resource.data.userId )
        ||
        /* Cualquier staff modera records (normales o reclamos) */
        ( isStaff() )
        ||
        /* Dueño edita su propio record (sin tocar userId, vuelve a Pending) */
        ( isOwnerOf(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == "Pending" );

      /* Delete: staff siempre; dueño solo si NO está Accepted. */
      allow delete: if isStaff()
                    || (isOwnerOf(resource.data.userId)
                        && resource.data.status != "Accepted");
    }

    /* ─── /users : datos de cuenta + ROL (igual que V14) ─────────── */
    match /users/{uid} {
      allow read:   if isOwnerOf(uid) || isStaff();
      allow create: if isOwnerOf(uid);

      allow update: if
        /* (A) self-update sin tocar role ni banned */
        ( isOwnerOf(uid)
          && !( "role"   in request.resource.data.diff(resource.data).affectedKeys() )
          && !( "banned" in request.resource.data.diff(resource.data).affectedKeys() )
        )
        ||
        /* (B) Owner: control total */
        ( isOwnerRole()
          && ( !( "role" in request.resource.data.diff(resource.data).affectedKeys() )
               || isValidRole(request.resource.data.role) )
        )
        ||
        /* (C) Admin: cambia roles de no-staff a no-staff, y no a sí mismo */
        ( myRole() == 'Admin'
          && uid != request.auth.uid
          && resource.data.role != 'Owner'
          && !( "banned" in request.resource.data.diff(resource.data).affectedKeys() )
          && (
               !( "role" in request.resource.data.diff(resource.data).affectedKeys() )
               || (
                    isValidRole(request.resource.data.role)
                    && !(request.resource.data.role in ['Admin','Owner'])
                  )
             )
        );

      allow delete: if isOwnerRole();
    }
  }
}
