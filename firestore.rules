// ============================================================
// BFT Demon List — Firestore Security Rules
// Versión: V22 (user_cosmetics: Staff puede conceder badges a otros)
// ============================================================
//
// CAMBIOS RESPECTO A V21:
//
//  1. /user_cosmetics/{uid}
//     - Staff (Mod/Admin/Owner) ahora puede actualizar el doc
//       de cosméticos de OTROS usuarios (no el propio).
//       Esto permite que al aceptar un record al 100%, el panel
//       conceda insignias de completion automáticamente.
//     - Un Staff NO puede modificar sus propios cosméticos más
//       allá de equippedBanner / equippedBadges (regla anterior
//       del dueño sigue vigente).
//     - Owner mantiene acceso total sin restricción de uid.
//
// INSTRUCCIONES DE DESPLIEGUE:
//
// Ve a Firebase Console → Firestore Database → Reglas
// y reemplaza el contenido completo por el de este archivo.
// Luego pulsa "Publicar".
//
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isAuth()       { return request.auth != null; }
    function meUid()        { return request.auth.uid; }
    function isOwnerOf(uid) { return isAuth() && meUid() == uid; }

    // Lee el rol del usuario autenticado desde /users/{uid}
    function myRole() {
      return isAuth()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role","Default")
        : "Default";
    }

    function isMod()      { return myRole() == "Mod";   }
    function isAdmin()    { return myRole() == "Admin";  }
    function isOwner()    { return myRole() == "Owner";  }
    function isAdminish() { return isAdmin() || isOwner(); }
    function isStaff()    { return isMod() || isAdmin() || isOwner(); }

    // ── /users/{uid} ────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;

      allow create: if isOwnerOf(uid);

      allow update: if isOwnerOf(uid) &&
        !("role"   in request.resource.data.diff(resource.data).affectedKeys()) &&
        !("banned" in request.resource.data.diff(resource.data).affectedKeys());

      allow update: if isOwner();

      allow update: if isAdmin() &&
        (
          !("role" in request.resource.data.diff(resource.data).affectedKeys()) ||
          !(request.resource.data.role in ["Admin","Owner"])
        ) &&
        (
          !("banned" in request.resource.data.diff(resource.data).affectedKeys()) ||
          resource.data.get("role","Default") != "Owner"
        );

      allow update: if isMod() &&
        !("role"   in request.resource.data.diff(resource.data).affectedKeys()) &&
        !("banned" in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if isAdminish();
    }

    // ── /profiles/{uid} ─────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if true;

      allow create: if isOwnerOf(uid) || isStaff();

      allow update: if isOwnerOf(uid) || isStaff();

      allow delete: if isAdminish();
    }

    // ── /levels/{id} ────────────────────────────────────────────
    match /levels/{id} {
      allow read:   if true;
      allow create: if isStaff();
      allow update: if isAdminish();
      allow delete: if isAdminish();
    }

    // ── /records/{id} ───────────────────────────────────────────
    match /records/{id} {
      allow read: if true;

      allow create: if isAuth() &&
        !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("banned", false);

      allow update: if isStaff() ||
        (isAuth() && resource.data.userId == meUid());

      allow delete: if isStaff() ||
        (isAuth() && resource.data.userId == meUid() && resource.data.status != "Accepted");
    }

    // ── /positionHistory/{id} ───────────────────────────────────
    match /positionHistory/{id} {
      allow read:   if true;
      allow create: if isStaff();
      allow update: if isAdminish();
      allow delete: if isAdminish();
    }

    // ── /changelog/{id} ─────────────────────────────────────────
    match /changelog/{id} {
      allow read:   if true;
      allow create: if isStaff();
      allow update: if isAdminish();
      allow delete: if isAdminish();
    }

    // ── /notifications/{id} ─────────────────────────────────────
    match /notifications/{id} {
      allow read:   if isAuth() && resource.data.userId == meUid();
      allow create: if isStaff();
      allow update: if isStaff() ||
        (isAuth() && resource.data.userId == meUid());
      allow delete: if isAdminish() ||
        (isAuth() && resource.data.userId == meUid());
    }

    // ── /banners/{id} ─────────────────────────────────────────────
    // [V20] Catálogo global de banners cosméticos.
    // Lectura pública para que los perfiles muestren el banner equipado.
    // Admin/Owner pueden crear/editar/eliminar banners del catálogo.
    match /banners/{id} {
      allow read:   if true;
      allow create: if isAdminish();
      allow update: if isAdminish();
      allow delete: if isAdminish();
    }

    // ── /badges/{id} ──────────────────────────────────────────────
    // [V20] Catálogo global de insignias (badges).
    // Lectura pública. Admin/Owner pueden escribir el catálogo.
    match /badges/{id} {
      allow read:   if true;
      allow create: if isAdminish();
      allow update: if isAdminish();
      allow delete: if isAdminish();
    }

    // ── /user_cosmetics/{uid} ─────────────────────────────────────
    // [V21] Inventario cosmético de cada usuario.
    //
    // Campos del documento:
    //   equippedBanner  : string | null   → banner ID equipado
    //   equippedBadges  : array<string>   → hasta 2 badge IDs
    //   unlockedBanners : array<string>   → IDs desbloqueados
    //   unlockedBadges  : array<string>   → IDs desbloqueados
    //
    // [V21] El dueño SOLO puede tocar equippedBanner / equippedBadges.
    // [V21] Solo el Owner puede conceder/revocar unlocks (unlockedBanners/Badges).
    //       Los Admins ya NO pueden modificar el inventario de cosméticos.
    match /user_cosmetics/{uid} {
      // Lectura pública: los perfiles muestran cosméticos equipados.
      allow read: if true;

      // Creación por el dueño: solo si NO viene con unlocks pre-populados.
      allow create: if isOwnerOf(uid) &&
        request.resource.data.get("unlockedBanners", []).size() == 0 &&
        request.resource.data.get("unlockedBadges",  []).size() == 0;

      // Actualización por el dueño: únicamente puede cambiar los campos de
      // equip. Los arrays unlockedBanners/Badges no pueden ser tocados.
      allow update: if isOwnerOf(uid) &&
        !("unlockedBanners" in request.resource.data.diff(resource.data).affectedKeys()) &&
        !("unlockedBadges"  in request.resource.data.diff(resource.data).affectedKeys());

      // [V22] Staff puede actualizar cosméticos de OTROS usuarios (no el propio)
      //       para conceder insignias automáticas al aceptar records.
      //       Owner mantiene acceso total sin restricción de uid.
      allow create: if isOwner();
      allow update: if isOwner();
      allow update: if isStaff() && request.auth.uid != uid;
      allow delete: if isOwner();
    }

  }
}
