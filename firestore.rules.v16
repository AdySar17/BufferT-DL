rules_version = '2';

/* ============================================================================
 *  BFT Demon List — Reglas de Firestore  (archivo V16)
 *
 *  CÓMO PUBLICAR:
 *    1. Firebase Console → proyecto bufferteam-a95b3
 *    2. Firestore Database → pestaña "Rules"
 *    3. Borra TODO lo que haya y pega este archivo entero
 *    4. Pulsa "Publish"
 *
 *  Cambios respecto a V15:
 *    - Sistema de "Reclamar revisión" en /records.
 *      Cuando un staff abre el panel y va a revisar un record,
 *      puede RECLAMARLO para evitar que otro staff esté revisando
 *      el mismo record en paralelo.
 *
 *      Campos nuevos en /records (todos opcionales):
 *        reviewClaimedBy     : uid del staff que reclamó la revisión
 *        reviewClaimedByName : nombre legible (mostrado al resto del staff)
 *        reviewClaimedAt     : serverTimestamp del reclamo
 *
 *      Reglas:
 *      • Cualquier staff puede ESCRIBIR esos tres campos para
 *        reclamar/quitar la reclamación, siempre y cuando NO toque
 *        ningún otro campo del record en esa misma operación
 *        (status, percent, video, …) y no cambie userId.
 *      • Para MODERAR (cambiar status u otros campos), el staff
 *        debe ser el que tiene el reclamo, O el record no debe estar
 *        reclamado por nadie.  Si está reclamado por OTRO staff la
 *        operación es rechazada por reglas.
 *      • Owner mantiene control total y puede sobrescribir reclamos.
 *      • El propio dueño del record (jugador) NO puede tocar los
 *        campos reviewClaim* (para evitar que un usuario malicioso
 *        "se autoreclame" su record y bloquee al staff).
 *
 *  Cambios respecto a V14 (heredados de V15):
 *    - Mods pueden moderar reclamos de "Nuevo nivel" y crear el nivel,
 *      pero NO pueden EDITAR el nivel después (solo position/value
 *      cambian, lo que ocurre durante el re-shift automático).
 *    - SEGURIDAD: los Admin no pueden BORRAR niveles (solo Owner).
 *
 *  Cambios respecto a V11 (heredados):
 *    - Owner puede crear records con cualquier `userId`.
 *
 *  Cambios respecto a V10 (heredados):
 *    - Owner puede actualizar cualquier record (sin cambiar userId).
 *
 *  Cambios respecto a V9 (heredados):
 *    - /profiles/{uid} admite el campo opcional `youtube`.
 *    - Stat "Hardest" se calcula en cliente.
 *
 *  Cambios respecto a V8 (heredados):
 *    - Reclamo de NUEVO NIVEL identificado por ID de Geometry Dash.
 *    - /levels admite gdLevelId opcional.
 *
 *  Roles soportados:
 *    Owner   — control total. Puede aceptar reclamos, editar todo,
 *              sobrescribir reclamos de revisión.
 *    Admin   — modera records, acepta reclamos, edita niveles libremente.
 *    Mod     — modera records (incluyendo reclamos de Nuevo nivel)
 *              y crea niveles al aceptar reclamos, pero NO puede
 *              editar datos de niveles ya existentes (solo el
 *              reajuste automático de position/value).
 *    Booster — sin permisos extra; solo prioridad en el panel + badge.
 *    Default — usuario normal.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helpers ───────────────────────────────────────────────── */
    function isSignedIn() { return request.auth != null; }
    function isOwnerOf(uid) { return isSignedIn() && request.auth.uid == uid; }

    function myDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return myDoc().data.role; }

    function isStaff()    { return isSignedIn() && myRole() in ['Mod','Admin','Owner']; }
    function isAdminish() { return isSignedIn() && myRole() in ['Admin','Owner']; }
    function isOwnerRole(){ return isSignedIn() && myRole() == 'Owner'; }

    function isValidRole(r) {
      return r in ['Default','Mod','Admin','Owner','Booster'];
    }

    /* Valida que la cadena sea solo dígitos 0-9, longitud 1..20.       *
     * Sirve para el ID de un nivel de Geometry Dash.                   */
    function isGdId(s) {
      return s is string
             && s.size() > 0
             && s.size() <= 20
             && s.matches('^[0-9]+$');
    }

    /* Helpers de "review claim" (V16) */
    function isClaimedByOther() {
      return ('reviewClaimedBy' in resource.data)
          && resource.data.reviewClaimedBy != null
          && resource.data.reviewClaimedBy != request.auth.uid;
    }
    function changesOnlyClaimFields() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['reviewClaimedBy','reviewClaimedByName','reviewClaimedAt']);
    }
    function touchesClaimFields() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['reviewClaimedBy','reviewClaimedByName','reviewClaimedAt']);
    }

    /* ─── Perfiles públicos ─────────────────────────────────────── */
    function isValidYoutube(v) {
      return !('youtube' in request.resource.data)
          || v == null
          || (v is string && v.size() == 0)
          || (v is string && v.size() <= 200 && v.matches('^https?://.*'));
    }
    match /profiles/{uid} {
      allow read:   if true;
      allow create: if isOwnerOf(uid)
                    && isValidYoutube(request.resource.data.youtube);
      allow update: if (isOwnerOf(uid) || isStaff())
                    && isValidYoutube(request.resource.data.youtube);
      allow delete: if isAdminish();
    }

    /* ─── Niveles públicos (igual que V15) ──────────────────────── */
    match /levels/{id} {
      allow read:   if true;
      allow create: if isStaff();
      allow update: if
        /* Admin/Owner: edición libre */
        isAdminish()
        ||
        /* Mod: SOLO reajuste de posición (y opcionalmente value) */
        ( isStaff()
          && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['position','value'])
        );
      allow delete: if isOwnerRole();
    }

    /* ─── Historial de posiciones (público, escribe staff) ─────── */
    match /positionHistory/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    /* ─── Records públicos ──────────────────────────────────────── *
     *  Campos básicos: userId, player2Id?, levelId, percent (1-100),
     *  video, video2?, mobile, mobile2P, mode2P, rawFootage, extraNotes,
     *  status ("Pending"|"Accepted"|"Rejected"),
     *  createdAt, updatedAt, acceptedAt,
     *  staffnotes (string opcional, hasta 500 chars),
     *  moderatedAt (serverTimestamp), moderatedBy (uid del staff).
     *
     *  Campos para reclamo de "Nuevo nivel":
     *    isNewLevelClaim, claimedLevelName, claimedLevelId
     *
     *  Campos para "Reclamar REVISIÓN" del staff (V16, opcionales):
     *    reviewClaimedBy, reviewClaimedByName, reviewClaimedAt        */
    match /records/{id} {
      allow read: if true;

      /* Crear: el propio usuario en estado Pending.
       * El rol Owner puede crear con cualquier userId. */
      allow create: if isSignedIn()
                    && ( request.resource.data.userId == request.auth.uid
                         || isOwnerRole() )
                    && request.resource.data.status == "Pending"
                    && (
                      ( !("isNewLevelClaim" in request.resource.data)
                        || request.resource.data.isNewLevelClaim == false )
                      ||
                      ( request.resource.data.isNewLevelClaim == true
                        && request.resource.data.claimedLevelName is string
                        && request.resource.data.claimedLevelName.size() > 0
                        && request.resource.data.claimedLevelName.size() <= 100
                        && isGdId(request.resource.data.claimedLevelId)
                      )
                    );

      /* Update — V16:
       *   (1) Owner: control total (sin cambiar userId).
       *   (2) Staff que SOLO toca los campos de "review claim"
       *       (reclamar / quitar reclamación):
       *         - no cambia ningún otro campo
       *         - no transfiere el record a otro userId
       *         - el record no debe estar reclamado por OTRO staff
       *           (excepto si es el mismo staff: puede sobrescribir
       *           su propio reclamo, p. ej. para refrescar el name).
       *   (3) Staff que MODERA u otra acción de staff:
       *         - el record NO puede estar reclamado por otro staff.
       *         - en esta operación NO puede tocar los campos de claim
       *           (para no "robar" un reclamo modificándolos al moderar).
       *           Si quiere quitarlos, lo hace con la op (2).
       *   (4) Dueño edita su propio record en Pending:
       *         - sin cambiar userId
       *         - sin tocar ningún campo de review claim. */
      allow update: if
        /* (1) Owner: total */
        ( isOwnerRole()
          && request.resource.data.userId == resource.data.userId )
        ||
        /* (2) Staff: claim/unclaim puro */
        ( isStaff()
          && changesOnlyClaimFields()
          && request.resource.data.userId == resource.data.userId
          && !isClaimedByOther()
        )
        ||
        /* (3) Staff: moderación normal */
        ( isStaff()
          && !touchesClaimFields()
          && !isClaimedByOther()
        )
        ||
        /* (4) Dueño edita su propio record en Pending */
        ( isOwnerOf(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == "Pending"
          && !touchesClaimFields()
        );

      /* Delete: staff siempre; dueño solo si NO está Accepted. */
      allow delete: if isStaff()
                    || (isOwnerOf(resource.data.userId)
                        && resource.data.status != "Accepted");
    }

    /* ─── /users : datos de cuenta + ROL (igual que V14/V15) ─────── */
    match /users/{uid} {
      allow read:   if isOwnerOf(uid) || isStaff();
      allow create: if isOwnerOf(uid);

      allow update: if
        /* (A) self-update sin tocar role ni banned */
        ( isOwnerOf(uid)
          && !( "role"   in request.resource.data.diff(resource.data).affectedKeys() )
          && !( "banned" in request.resource.data.diff(resource.data).affectedKeys() )
        )
        ||
        /* (B) Owner: control total */
        ( isOwnerRole()
          && ( !( "role" in request.resource.data.diff(resource.data).affectedKeys() )
               || isValidRole(request.resource.data.role) )
        )
        ||
        /* (C) Admin: cambia roles de no-staff a no-staff, y no a sí mismo */
        ( myRole() == 'Admin'
          && uid != request.auth.uid
          && resource.data.role != 'Owner'
          && !( "banned" in request.resource.data.diff(resource.data).affectedKeys() )
          && (
               !( "role" in request.resource.data.diff(resource.data).affectedKeys() )
               || (
                    isValidRole(request.resource.data.role)
                    && !(request.resource.data.role in ['Admin','Owner'])
                  )
             )
        );

      allow delete: if isOwnerRole();
    }
  }
}
